{
  "name": "board-excalidraw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lavagna collaborativa per i corsi Cube Academy (Excalidraw, licenza MIT + server di sincronizzazione)",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "token": "node scripts/make-token.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
