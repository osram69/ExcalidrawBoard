# Chiave per firmare i link d'accesso alle board. Stessa stringa sul sito Cube Academy (che emette i link) e qui.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOARD_SECRET=

# Token del tunnel Cloudflare (Zero Trust > Networks > Tunnels). Serve solo con: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Accesso degli allievi (facoltativi): ore di validità del login e giorni con "ricordami"
LOGIN_TOKEN_HOURS=12
LOGIN_REMEMBER_DAYS=7
